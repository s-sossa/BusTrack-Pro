# ==============================================================================
# BusTrack Pro — Production Environment Template
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a `.env`:
#      cp .env.example .env
# 2. Genera un JWT_SECRET criptográfico nuevo con:
#      openssl rand -base64 64
# 3. NUNCA subas el archivo `.env` al repositorio de código.
# ==============================================================================

# Entorno de ejecución: 'production' en despliegue, 'development' en local
NODE_ENV=production

# Puerto HTTP en el que escuchará el servidor Express
PORT=3000

# Dominios permitidos por CORS (separados por coma si son varios).
# ⛔ NUNCA uses '*' en producción.
# Ejemplo: CORS_ORIGIN=https://bustrack.tu-dominio.cr,https://admin.bustrack.tu-dominio.cr
CORS_ORIGIN=https://bustrack.tu-dominio.cr

# Secreto para firma y verificación de tokens JWT.
# ⛔ OBLIGATORIO: Mínimo 32 caracteres criptográficamente seguros.
# Generar con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_POR_CADENA_ALEATORIA_GENERADA_CON_OPENSSL_RAND_BASE64_64

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# URL del proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública / anónima (usada por clientes frontend y backend general)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica_aqui
SUPABASE_ANON_KEY=sb_publishable_tu_clave_publica_aqui

# Clave administrativa con permisos elevados (Service Role).
# ⛔ SOLO para el servidor backend. NUNCA la expongas en frontend ni variables VITE_.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta_aqui

# Forzar error al arrancar si falta SUPABASE_SERVICE_ROLE_KEY en producción
REQUIRE_SERVICE_ROLE=true

# ==============================================================================
# BASE DE DATOS POSTGRESQL / DOCKER
# ==============================================================================
# URL de conexión a PostgreSQL (opcional si usas SQLite integrado)
# Ejemplo: DATABASE_URL=postgresql://bustrack_user:password_seguro@localhost:5432/bustrack_db
DATABASE_URL=

# Configuración para contenedor Docker local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_EN_PRODUCCION
POSTGRES_DB=bustrack_db

# ==============================================================================
# COPIAS PARA FRONTEND (Build tools / Vite)
# ==============================================================================
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_tu_clave_publica_aqui


# ==============================================================================
# STRIPE PAYMENT GATEWAY
# ==============================================================================
# Clave secreta de Stripe — ⛔ SOLO para el servidor backend. NUNCA en el cliente.
# Generar en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_CAMBIAR_POR_TU_CLAVE_SECRETA_DE_STRIPE

# Clave pública de Stripe — Segura para usar en el navegador (cliente frontend)
# Se inyecta en index.html como window.__STRIPE_PK__ vía el servidor Express
STRIPE_PUBLISHABLE_KEY=pk_test_CAMBIAR_POR_TU_CLAVE_PUBLICA_DE_STRIPE

# Secreto de Webhook de Stripe — Para verificar firmas de eventos entrantes de Stripe
# Obtenerlo en: https://dashboard.stripe.com/webhooks
# En local usar: stripe listen --forward-to localhost:3000/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_CAMBIAR_POR_TU_WEBHOOK_SECRET
