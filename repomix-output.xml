          <div class="auth-feature-card">
            <span class="auth-feature-icon">🚨</span>
            <div class="auth-feature-text">
              <h4>Alertas e Incidentes</h4>
              <p>Notificaciones inmediatas de retrasos, mantenimiento y motor.</p>
