# ==============================================================================
# BusTrack Pro — Environment Configuration Example
# Copy this file to .env and configure your environment variables
# ==============================================================================

PORT=3000
NODE_ENV=development

# ⛔ CORS_ORIGIN: In production change to your frontend domain (e.g. https://bustrack.example.com)
CORS_ORIGIN=http://localhost:3000

# ⛔ Mandatory: Change this secret in production
JWT_SECRET=bustrack_pro_production_secret_key_change_me_in_prod

# Simulation Engine Timers (in ms)
TELEMETRY_INTERVAL_MS=3000
ACTIVITY_INTERVAL_MS=9000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Supabase Project URL
SUPABASE_URL=https://jhuvaqrdhkzxqmvcrlws.supabase.co

# Supabase Public / Anon Key (safe for client/public use)
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Supabase Service Role Key (backend only, bypasses RLS for administrative access)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend (Vite / client copy)
VITE_SUPABASE_URL=https://jhuvaqrdhkzxqmvcrlws.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
